{% comment %}
  Quick Shop Modal - Add to layout/theme.liquid before </body>
{% endcomment %}

<div id="quickShopModal" class="quick-shop-modal" style="display: none;">
  <div class="quick-shop-overlay"></div>
  <div class="quick-shop-content">
    <button class="quick-shop-close" aria-label="Close">&times;</button>
    
    <div class="quick-shop-grid">
      <!-- Product Image -->
      <div class="quick-shop-image">
        <img id="quickShopImage" src="" alt="">
      </div>
      
      <!-- Product Details -->
      <div class="quick-shop-details">
        <h2 id="quickShopTitle" class="quick-shop-title"></h2>
        <div id="quickShopPrice" class="quick-shop-price"></div>
        <div id="quickShopDescription" class="quick-shop-description"></div>
        
        <form id="quickShopForm" class="quick-shop-form">
          <div class="quick-shop-quantity">
            <label>Quantity:</label>
            <input type="number" name="quantity" value="1" min="1">
          </div>
          
          <button type="submit" class="quick-shop-add-btn">Add to Cart</button>
          <a id="quickShopViewFull" href="#" class="quick-shop-view-full">View Full Details</a>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
.quick-shop-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-shop-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(5px);
}

.quick-shop-content {
  position: relative;
  background: #fff;
  max-width: 900px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  z-index: 10001;
  opacity: 0;
  transform: scale(0.9);
  transition: all 0.3s ease;
}

.quick-shop-modal.active .quick-shop-content {
  opacity: 1;
  transform: scale(1);
}

.quick-shop-close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
  z-index: 10002;
  color: #333;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.3s;
}

.quick-shop-close:hover {
  color: #000;
}

.quick-shop-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  padding: 60px;
}

.quick-shop-image img {
  width: 100%;
  aspect-ratio: 9/16;
  object-fit: cover;
}

.quick-shop-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.quick-shop-title {
  font-size: 1.8rem;
  font-weight: 300;
  margin-bottom: 20px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.quick-shop-price {
  font-size: 1.5rem;
  color: #8a7355;
  margin-bottom: 20px;
}

.quick-shop-description {
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 30px;
  color: #555;
}

.quick-shop-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.quick-shop-quantity {
  display: flex;
  align-items: center;
  gap: 15px;
}

.quick-shop-quantity input {
  width: 60px;
  padding: 10px;
  border: 1px solid rgba(0,0,0,0.2);
  text-align: center;
}

.quick-shop-add-btn {
  padding: 18px 40px;
  background: #1a1a1a;
  color: #fff;
  border: none;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.3s;
  font-family: inherit;
}

.quick-shop-add-btn:hover {
  background: #333;
}

.quick-shop-view-full {
  text-align: center;
  color: #555;
  text-decoration: none;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: color 0.3s;
}

.quick-shop-view-full:hover {
  color: #1a1a1a;
}

@media (max-width: 768px) {
  .quick-shop-grid {
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 40px 20px;
  }
  
  .quick-shop-close {
    top: 10px;
    right: 10px;
  }
}
</style>

<script>
  // Quick Shop Modal Functionality
  window.quickShop = {
    modal: null,
    
    init() {
      this.modal = document.getElementById('quickShopModal');
      const closeBtn = document.querySelector('.quick-shop-close');
      const overlay = document.querySelector('.quick-shop-overlay');
      
      if (closeBtn) closeBtn.addEventListener('click', () => this.close());
      if (overlay) overlay.addEventListener('click', () => this.close());
      
      // ESC key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.modal.style.display === 'flex') {
          this.close();
        }
      });
    },
    
    open(productData) {
      if (!this.modal) return;
      
      // Populate modal
      document.getElementById('quickShopImage').src = productData.image;
      document.getElementById('quickShopImage').alt = productData.title;
      document.getElementById('quickShopTitle').textContent = productData.title;
      document.getElementById('quickShopPrice').textContent = productData.price;
      document.getElementById('quickShopDescription').textContent = productData.description || '';
      document.getElementById('quickShopViewFull').href = productData.url;
      
      // Show modal
      this.modal.style.display = 'flex';
      setTimeout(() => this.modal.classList.add('active'), 10);
      document.body.style.overflow = 'hidden';
    },
    
    close() {
      if (!this.modal) return;
      
      this.modal.classList.remove('active');
      setTimeout(() => {
        this.modal.style.display = 'none';
        document.body.style.overflow = '';
      }, 300);
    }
  };
  
  // Initialize on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    window.quickShop.init();
  });
</script>
