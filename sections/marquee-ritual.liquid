{% schema %}
{
  "name": "Ritual Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 35,
      "label": "Speed (seconds)"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "✦ Handcrafted for the modern ritual"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "✦ From us to you, worldwide — in sacred care" } },
        { "type": "text", "settings": { "text": "✦ Handcrafted for the modern ritual" } },
        { "type": "text", "settings": { "text": "✦ Each piece blessed under the full moon" } },
        { "type": "text", "settings": { "text": "✦ Free shipping on orders over ₹5,000" } }
      ]
    }
  ]
}
{% endschema %}

<style>
.ritual-marquee-section {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
  padding: 18px 0;
  position: relative;
}

.ritual-marquee-track {
  display: flex;
  width: max-content;
  animation: marquee-scroll {{ section.settings.speed }}s linear infinite;
}

.ritual-marquee-track:hover {
  animation-play-state: paused;
}

.ritual-marquee-content {
  display: flex;
  gap: 60px;
  padding-right: 60px;
}

.ritual-marquee-item {
  white-space: nowrap;
  font-size: 0.85rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 400;
}

@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Disable on reduced motion */
@media (prefers-reduced-motion: reduce) {
  .ritual-marquee-track {
    animation: none;
  }
}

/* Mobile - slower */
@media (max-width: 768px) {
  .ritual-marquee-section {
    padding: 15px 0;
  }
  
  .ritual-marquee-item {
    font-size: 0.75rem;
  }
}
</style>

<section class="ritual-marquee-section">
  <div class="ritual-marquee-track">
    {% for i in (1..4) %}
      <div class="ritual-marquee-content">
        {% for block in section.blocks %}
          <span class="ritual-marquee-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>
