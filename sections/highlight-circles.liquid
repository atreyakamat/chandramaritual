{% schema %}
{
  "name": "Highlight Circles",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fcfbf9"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Label",
          "default": "About Us"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlight Circles",
      "blocks": [
        {
          "type": "highlight",
          "settings": { "link_label": "About Us" }
        },
        {
          "type": "highlight",
          "settings": { "link_label": "Kalbeliya" }
        },
        {
          "type": "highlight",
          "settings": { "link_label": "Talismans" }
        },
        {
           "type": "highlight",
           "settings": { "link_label": "Kansa Tools" }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.highlight-circles-section {
  padding: 60px 20px;
  text-align: center;
}

.highlight-grid {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.highlight-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150px;
  text-decoration: none;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.highlight-image-wrapper {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 25px;
  background-color: #ddd; /* Placeholder */
}

.highlight-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.highlight-item:hover .highlight-image-wrapper img {
  transform: scale(1.1);
}

.highlight-label {
  background-color: #000;
  color: #fff;
  padding: 12px 20px;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  font-weight: 500;
  min-width: 140px;
  text-align: center;
  transition: opacity 0.3s ease;
}

.highlight-item:hover .highlight-label {
  opacity: 0.8;
}

@media (max-width: 768px) {
  .highlight-grid {
    gap: 30px;
  }
}
{% endstyle %}

<section class="highlight-circles-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="highlight-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link_url | default: '#' }}" class="highlight-item">
        <div class="highlight-image-wrapper">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 240 }}" 
                 alt="{{ block.settings.link_label | escape }}"
                 loading="lazy"
                 width="{{ block.settings.image.width }}"
                 height="{{ block.settings.image.height }}">
          {% else %}
             {{ 'collection-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="highlight-label">{{ block.settings.link_label }}</div>
      </a>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
       gsap.to(".highlight-item", {
         scrollTrigger: {
            trigger: ".highlight-grid",
            start: "top 85%"
         },
         opacity: 1,
         y: 0,
         stagger: 0.1,
         duration: 0.8,
         ease: "power2.out"
       });
    }
  });
</script>
