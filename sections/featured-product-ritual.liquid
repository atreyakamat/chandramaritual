{% schema %}
{
  "name": "Featured Product Ritual",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Isis Sevenfold Ascension"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A talisman of sovereignty and remembrance."
    }
  ],
  "presets": [
    {
      "name": "Featured Product Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.featured-ritual-section {
  padding: 80px 20px;
  background-color: #fcfbf9;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.featured-ritual-image {
  width: 100%;
  max-width: 600px;
  margin-bottom: 40px;
  opacity: 0; /* GSAP initial state */
}

.featured-ritual-image img {
  width: 100%;
  height: auto;
  display: block;
}

.featured-ritual-content {
  max-width: 500px;
  opacity: 0; /* GSAP initial state */
  transform: translateY(20px);
}

.featured-ritual-content h2 {
  font-size: 1.8rem;
  font-weight: 300;
  margin-bottom: 1rem;
  letter-spacing: 0.05em;
}

.featured-ritual-content p {
  font-size: 1.1rem;
  font-weight: 300;
  color: #555;
  margin-bottom: 2rem;
}

.ritual-btn {
  display: inline-block;
  padding: 12px 30px;
  border: 1px solid #333;
  color: #333;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.ritual-btn:hover {
  background-color: #333;
  color: #fff;
}
{% endstyle %}

<section class="featured-ritual-section">
  {% assign product = section.settings.product %}
  <div class="featured-ritual-image">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 1000 }}" 
           alt="{{ product.title | escape }}"
           loading="lazy"
           width="{{ product.featured_image.width }}"
           height="{{ product.featured_image.height }}">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  
  <div class="featured-ritual-content">
    <h2>{{ section.settings.heading | default: product.title }}</h2>
    <p>{{ section.settings.text }}</p>
    <a href="{{ product.url }}" class="ritual-btn">View Piece</a>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
       const section = document.querySelector('.featured-ritual-section');
       
       gsap.to(section.querySelector('.featured-ritual-image'), {
         scrollTrigger: {
            trigger: section,
            start: "top 70%"
         },
         opacity: 1,
         duration: 1.5,
         ease: "power2.out"
       });

       gsap.to(section.querySelector('.featured-ritual-content'), {
         scrollTrigger: {
            trigger: section,
            start: "top 70%"
         },
         opacity: 1,
         y: 0,
         duration: 1.2,
         delay: 0.3,
         ease: "power2.out"
       });
    }
  });
</script>
