{% schema %}
{
  "name": "Collage Ritual",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "default": 20,
      "label": "Background Overlay Opacity %"
    },
    {
      "type": "header",
      "content": "Center Images"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top Image"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom Image"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Image Border Color",
      "default": "#4a5d50"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "text_left",
      "label": "Left Text",
      "default": "ADORN YOUR WAIST"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Right Text",
      "default": "ELEVATE YOUR STYLE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Collage Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.collage-ritual-section {
  position: relative;
  width: 100%;
  min-height: 600px; /* Adjust as needed */
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 60px 0;
}

.collage-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.collage-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collage-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #000;
  z-index: 2;
  pointer-events: none;
}

.collage-content-grid {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 40px;
  padding: 0 40px;
}

.collage-text {
  font-family: var(--font-heading-family); /* Or theme font */
  font-size: 1.8rem;
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.text-left {
  text-align: right;
  padding-right: 20px;
}

.text-right {
  text-align: left;
  padding-left: 20px;
}

.collage-center-images {
  position: relative;
  width: 300px; /* Adjust sizing */
  height: 500px; 
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.collage-img-wrapper {
  position: absolute;
  border: 4px solid {{ section.settings.border_color }};
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  opacity: 0; /* GSAP */
}

.collage-img-wrapper img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Specific positioning for the "stack" effect */
.img-top {
  width: 240px;
  height: 240px;
  top: 0;
  right: 0; /* Offset right slightly? Default center for now or strictly stacked vertical */
  transform: translate(20px, 0); /* Initial offset for logic, but we'll center */
  z-index: 4;
  /* Resetting exact pos for centering logic */
  position: relative; /* Changing to relative flow for flex centering if easier, or keep absolute */
  /* Let's stick to absolute to match the 'overlap' feel exactly */
  position: absolute;
  top: 0;
  right: -20px;
}

.img-bottom {
  width: 240px;
  height: 240px;
  bottom: 0;
  left: -20px;
  z-index: 5;
}

@media (max-width: 900px) {
  .collage-content-grid {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 30px;
  }
  
  .text-left, .text-right {
    text-align: center;
    padding: 0;
  }
  
  .collage-center-images {
    width: 100%;
    height: 400px;
    margin: 20px 0;
  }
  
  .img-top {
    right: auto;
    left: 50%;
    top: 10px;
    margin-left: -80px; /* Center ish */
  }
  
  .img-bottom {
    left: 50%;
    bottom: 10px;
    margin-left: -140px; /* Offset left */
  }
}
{% endstyle %}

<section class="collage-ritual-section">
  
  <!-- Background -->
  <div class="collage-bg">
    {% if section.settings.bg_image %}
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" 
           alt="" 
           loading="lazy"
           class="parallax-bg-img">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  
  <div class="collage-overlay" style="opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>

  <!-- Content -->
  <div class="collage-content-grid">
    
    <div class="collage-text text-left" style="color: {{ section.settings.text_color }};">
      {{ section.settings.text_left }}
    </div>

    <div class="collage-center-images">
      <div class="collage-img-wrapper img-top">
        {% if section.settings.image_top %}
          <img src="{{ section.settings.image_top | image_url: width: 500 }}" 
               alt="" 
               loading="lazy"
               width="{{ section.settings.image_top.width }}"
               height="{{ section.settings.image_top.height }}">
        {% else %}
           {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      
      <div class="collage-img-wrapper img-bottom">
        {% if section.settings.image_bottom %}
          <img src="{{ section.settings.image_bottom | image_url: width: 500 }}" 
               alt="" 
               loading="lazy"
               width="{{ section.settings.image_bottom.width }}"
               height="{{ section.settings.image_bottom.height }}">
        {% else %}
           {{ 'product-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
    </div>

    <div class="collage-text text-right" style="color: {{ section.settings.text_color }};">
      {{ section.settings.text_right }}
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        const section = document.querySelector('.collage-ritual-section');
        
        // Background Parallax
        gsap.to(".parallax-bg-img", {
            scrollTrigger: {
                trigger: section,
                start: "top bottom",
                end: "bottom top",
                scrub: true
            },
            y: 50, // Gentle parallax
            ease: "none"
        });
        
        // Text Animation
        gsap.to(".collage-text", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.2,
            ease: "power2.out"
        });
        
        // Images Animation
        // Top image floats down, Bottom floats up or vice versa for dynamic feel
        gsap.fromTo(".img-top", 
            { opacity: 0, y: -40 },
            { 
              scrollTrigger: {
                 trigger: section,
                 start: "top 75%"
              },
              opacity: 1,
              y: 0,
              duration: 1.2,
              ease: "power3.out"
            }
        );
        
        gsap.fromTo(".img-bottom", 
            { opacity: 0, y: 40 },
            { 
              scrollTrigger: {
                 trigger: section,
                 start: "top 75%"
              },
              opacity: 1,
              y: 0,
              duration: 1.2,
              delay: 0.2,
              ease: "power3.out"
            }
        );
    }
  });
</script>
