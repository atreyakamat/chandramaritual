{% schema %}
{
  "name": "Testimonials Marquee Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f3ef"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Speed (seconds)",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "These pieces feel sacred. Each time I wear them, I'm reminded of my intention."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Marquee Ritual",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "These pieces feel sacred. Each time I wear them, I'm reminded of my intention.",
            "author": "Sarah M."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Minimalist ritual adornment at its finest. The quality is extraordinary.",
            "author": "Priya K."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I feel connected to ancient wisdom when I wear Chandrama. Simply beautiful.",
            "author": "Luna R."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The waist chains are works of art. They've become part of my daily ritual.",
            "author": "Maya D."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.testimonials-marquee-section {
  padding: 60px 0;
  overflow: hidden;
  position: relative;
}

.testimonials-marquee-wrapper {
  display: flex;
  width: fit-content;
  animation: scroll-testimonials {{ section.settings.speed }}s linear infinite;
}

.testimonial-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-width: 400px;
  max-width: 400px;
  margin: 0 40px;
  padding: 40px;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(0,0,0,0.05);
  white-space: normal;
}

.testimonial-stars {
  font-size: 1.2rem;
  color: #8a7355;
  margin-bottom: 20px;
  letter-spacing: 0.2em;
}

.testimonial-quote {
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 20px;
  color: #333;
  font-weight: 300;
  font-style: italic;
}

.testimonial-author {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #8a7355;
  font-weight: 500;
}

@keyframes scroll-testimonials {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Pause on hover */
.testimonials-marquee-section:hover .testimonials-marquee-wrapper {
  animation-play-state: paused;
}

/* Mobile: Slower, smaller cards */
@media (max-width: 768px) {
  .testimonial-card {
    min-width: 300px;
    max-width: 300px;
    padding: 30px 20px;
    margin: 0 20px;
  }
  
  .testimonial-quote {
    font-size: 0.9rem;
  }
  
  .testimonials-marquee-wrapper {
    animation-duration: 50s;
  }
}

/* Disable on prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .testimonials-marquee-wrapper {
    animation: none;
  }
}
{% endstyle %}

<section class="testimonials-marquee-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="testimonials-marquee-wrapper">
    <!-- Duplicate content multiple times for seamless loop -->
    {% for i in (1..6) %}
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">★★★★★</div>
          <div class="testimonial-quote">"{{ block.settings.quote }}"</div>
          <div class="testimonial-author">— {{ block.settings.author }}</div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.from(".testimonials-marquee-section", {
        scrollTrigger: {
          trigger: ".testimonials-marquee-section",
          start: "top 90%"
        },
        opacity: 0,
        duration: 1,
        ease: "power2.out"
      });
    }
  });
</script>
