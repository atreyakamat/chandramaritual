{% schema %}
{
  "name": "Collection Products Ritual",
  "settings": [
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Products per row"
    }
  ]
}
{% endschema %}

{% style %}
.collection-products-ritual {
  padding: 60px 40px 100px;
  background-color: #faf9f6;
}

.collection-products-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);
  gap: 40px;
  max-width: 1400px;
  margin: 0 auto;
}

.collection-product-card {
  position: relative;
  opacity: 0;
  transform: translateY(30px);
}

.collection-product-image {
  position: relative;
  aspect-ratio: 9/16;
  overflow: hidden;
  margin-bottom: 20px;
  background: #f5f3ef;
}

.collection-product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.collection-product-card:hover .collection-product-image img {
  transform: scale(1.05);
}

/* Hover Actions */
.product-hover-overlay {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 10;
}

.collection-product-card:hover .product-hover-overlay {
  opacity: 1;
}

.hover-action-btn {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.75);
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.hover-action-btn:hover {
  background: rgba(0, 0, 0, 0.9);
  transform: translateY(-3px);
}

.hover-action-btn svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.hover-action-label {
  position: absolute;
  bottom: 55px;
  left: 50%;
  transform: translateX(-50%);
  background: #000;
  color: #fff;
  padding: 5px 10px;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.hover-action-btn:hover .hover-action-label {
  opacity: 1;
}

.collection-product-title {
  font-size: 0.95rem;
  font-weight: 400;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
}

.collection-product-title a {
  color: #333;
  text-decoration: none;
  transition: color 0.3s;
}

.collection-product-title a:hover {
  color: #8a7355;
}

.collection-product-price {
  text-align: center;
  font-size: 1.1rem;
  color: #8a7355;
  font-weight: 400;
}

@media (max-width: 1024px) {
  .collection-products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
}

@media (max-width: 768px) {
  .collection-products-ritual {
    padding: 40px 20px 80px;
  }
  
  .collection-products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  
  .collection-product-title {
    font-size: 0.85rem;
  }
}
{% endstyle %}

<section class="collection-products-ritual">
  <div class="collection-products-grid">
    {% paginate collection.products by 12 %}
      {% for product in collection.products %}
        <div class="collection-product-card" data-product-handle="{{ product.handle }}">
          <div class="collection-product-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" 
                     alt="{{ product.title | escape }}"
                     loading="lazy"
                     width="{{ product.featured_image.width }}"
                     height="{{ product.featured_image.height }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
            
            <div class="product-hover-overlay">
              <button class="hover-action-btn wishlist-btn" data-product-id="{{ product.id }}">
                <span class="hover-action-label">Wishlist</span>
                <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </button>
              
              <button class="hover-action-btn quickshop-btn"
                      data-product-url="{{ product.url }}"
                      data-product-title="{{ product.title | escape }}"
                      data-product-price="{{ product.price | money }}"
                      data-product-image="{{ product.featured_image | image_url: width: 800 }}">
                <span class="hover-action-label">Quick View</span>
                <svg viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
              </button>
              
              <button class="hover-action-btn addtocart-btn" data-variant-id="{{ product.variants.first.id }}">
                <span class="hover-action-label">Add to Cart</span>
                <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
              </button>
            </div>
          </div>
          
          <h3 class="collection-product-title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <div class="collection-product-price">{{ product.price | money }}</div>
        </div>
      {% endfor %}
      
      {% if paginate.pages > 1 %}
        <div class="pagination" style="grid-column: 1 / -1; text-align: center; margin-top: 40px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.to(".collection-product-card", {
        scrollTrigger: {
          trigger: ".collection-products-grid",
          start: "top 85%"
        },
        opacity: 1,
        y: 0,
        stagger: 0.1,
        duration: 0.8,
        ease: "power2.out"
      });
    }
    
    // Quick Shop
    document.querySelectorAll('.quickshop-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        if (window.quickShop) {
          window.quickShop.open({
            title: this.dataset.productTitle,
            price: this.dataset.productPrice,
            image: this.dataset.productImage,
            url: this.dataset.productUrl
          });
        }
      });
    });
    
    // Add to Cart
    document.querySelectorAll('.addtocart-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const variantId = this.dataset.variantId;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        }).then(() => {
          this.innerHTML = '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="currentColor"/></svg>';
          setTimeout(() => {
            this.innerHTML = '<span class="hover-action-label">Add to Cart</span><svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" fill="currentColor"/></svg>';
          }, 1500);
        });
      });
    });
  });
</script>
