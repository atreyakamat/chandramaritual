{% schema %}
{
  "name": "Contact Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf9f6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We're here to help with all your inquiries."
    }
  ],
  "presets": [
    {
      "name": "Contact Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.contact-ritual-section {
  padding: 100px 40px;
}

.contact-heading {
  text-align: center;
  font-size: 3rem;
  font-weight: 300;
  margin-bottom: 20px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0; /* GSAP */
  transform: translateY(30px);
}

.contact-subtext {
  text-align: center;
  font-size: 1.2rem;
  margin-bottom: 80px;
  opacity: 0.7;
  font-weight: 300;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.contact-forms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 60px;
  max-width: 1400px;
  margin: 0 auto;
}

.contact-form-card {
  background: #fff;
  padding: 50px 40px;
  border: 1px solid rgba(0,0,0,0.08);
  opacity: 0; /* GSAP */
  transform: translateY(30px);
}

.form-card-title {
  font-size: 1.5rem;
  font-weight: 300;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #1a1a1a;
}

.form-card-desc {
  font-size: 0.9rem;
  margin-bottom: 30px;
  opacity: 0.7;
  line-height: 1.5;
  font-weight: 300;
}

.ritual-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ritual-form label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
  display: block;
  font-weight: 400;
}

.ritual-form input,
.ritual-form textarea,
.ritual-form select {
  width: 100%;
  padding: 15px;
  border: 1px solid rgba(0,0,0,0.2);
  background: #fafafa;
  font-size: 0.95rem;
  font-family: inherit;
  transition: border-color 0.3s;
}

.ritual-form input:focus,
.ritual-form textarea:focus,
.ritual-form select:focus {
  outline: none;
  border-color: #333;
  background: #fff;
}

.ritual-form textarea {
  min-height: 120px;
  resize: vertical;
}

.ritual-form button {
  padding: 18px 40px;
  background: #1a1a1a;
  color: #fff;
  border: none;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
  font-family: inherit;
  font-weight: 500;
}

.ritual-form button:hover {
  background: #333;
  transform: translateY(-2px);
}

.ritual-form button:active {
  transform: translateY(0);
}

.form-success, .form-error {
  padding: 15px;
  margin-bottom: 20px;
  border-radius: 0;
  font-size: 0.9rem;
  display: none;
}

.form-success {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #4caf50;
}

.form-error {
  background: #ffebee;
  color: #c62828;
  border: 1px solid #f44336;
}

@media (max-width: 900px) {
  .contact-forms-grid {
    grid-template-columns: 1fr;
  }
  
  .contact-heading {
    font-size: 2rem;
  }
}
{% endstyle %}

<section class="contact-ritual-section" style="background-color: {{ section.settings.bg_color }};">
  <h2 class="contact-heading">{{ section.settings.heading }}</h2>
  <p class="contact-subtext">{{ section.settings.subtext }}</p>

  <div class="contact-forms-grid">
    
    <!-- Customer Service Form -->
    <div class="contact-form-card">
      <h3 class="form-card-title">Customer Service</h3>
      <p class="form-card-desc">Questions about orders, shipping, or products? We're here to help.</p>
      
      <div class="form-success" id="success-customer-service"></div>
      <div class="form-error" id="error-customer-service"></div>
      
      {% form 'contact', id: 'contact-customer-service', class: 'ritual-form' %}
        <input type="hidden" name="contact[subject]" value="Customer Service Inquiry">
        
        <div>
          <label for="cs-name">Name *</label>
          <input type="text" id="cs-name" name="contact[name]" required>
        </div>
        
        <div>
          <label for="cs-email">Email *</label>
          <input type="email" id="cs-email" name="contact[email]" required>
        </div>
        
        <div>
          <label for="cs-order">Order Number (Optional)</label>
          <input type="text" id="cs-order" name="contact[order_number]">
        </div>
        
        <div>
          <label for="cs-message">Message *</label>
          <textarea id="cs-message" name="contact[body]" required></textarea>
        </div>
        
        <button type="submit">Send Message</button>
      {% endform %}
    </div>

    <!-- Custom Orders Form -->
    <div class="contact-form-card">
      <h3 class="form-card-title">Custom Orders</h3>
      <p class="form-card-desc">Looking for a bespoke piece? Share your vision with us.</p>
      
      <div class="form-success" id="success-custom-orders"></div>
      <div class="form-error" id="error-custom-orders"></div>
      
      {% form 'contact', id: 'contact-custom-orders', class: 'ritual-form' %}
        <input type="hidden" name="contact[subject]" value="Custom Order Request">
        
        <div>
          <label for="co-name">Name *</label>
          <input type="text" id="co-name" name="contact[name]" required>
        </div>
        
        <div>
          <label for="co-email">Email *</label>
          <input type="email" id="co-email" name="contact[email]" required>
        </div>
        
        <div>
          <label for="co-phone">Phone</label>
          <input type="tel" id="co-phone" name="contact[phone]">
        </div>
        
        <div>
          <label for="co-type">Type of Piece</label>
          <select id="co-type" name="contact[piece_type]">
            <option value="">Select...</option>
            <option value="waist-chain">Waist Chain</option>
            <option value="necklace">Necklace</option>
            <option value="bracelet">Bracelet</option>
            <option value="anklet">Anklet</option>
            <option value="other">Other</option>
          </select>
        </div>
        
        <div>
          <label for="co-details">Design Details *</label>
          <textarea id="co-details" name="contact[body]" placeholder="Describe your vision, materials, sizing, etc." required></textarea>
        </div>
        
        <button type="submit">Submit Request</button>
      {% endform %}
    </div>

    <!-- Wholesale Orders Form -->
    <div class="contact-form-card">
      <h3 class="form-card-title">Wholesale Orders</h3>
      <p class="form-card-desc">Interested in carrying Chandrama Ritual? Let's collaborate.</p>
      
      <div class="form-success" id="success-wholesale"></div>
      <div class="form-error" id="error-wholesale"></div>
      
      {% form 'contact', id: 'contact-wholesale', class: 'ritual-form' %}
        <input type="hidden" name="contact[subject]" value="Wholesale Inquiry">
        
        <div>
          <label for="ws-name">Contact Name *</label>
          <input type="text" id="ws-name" name="contact[name]" required>
        </div>
        
        <div>
          <label for="ws-email">Email *</label>
          <input type="email" id="ws-email" name="contact[email]" required>
        </div>
        
        <div>
          <label for="ws-company">Company/Store Name *</label>
          <input type="text" id="ws-company" name="contact[company]" required>
        </div>
        
        <div>
          <label for="ws-website">Website (Optional)</label>
          <input type="url" id="ws-website" name="contact[website]">
        </div>
        
        <div>
          <label for="ws-location">Location</label>
          <input type="text" id="ws-location" name="contact[location]" placeholder="City, Country">
        </div>
        
        <div>
          <label for="ws-message">Tell Us About Your Business *</label>
          <textarea id="ws-message" name="contact[body]" placeholder="Store type, target audience, order quantity, etc." required></textarea>
        </div>
        
        <button type="submit">Submit Inquiry</button>
      {% endform %}
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        const section = document.querySelector('.contact-ritual-section');
        
        // Heading Animation
        gsap.to(".contact-heading", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out"
        });
        
        gsap.to(".contact-subtext", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            delay: 0.2,
            ease: "power2.out"
        });
        
        // Form Cards Stagger
        gsap.to(".contact-form-card", {
            scrollTrigger: {
                trigger: ".contact-forms-grid",
                start: "top 80%"
            },
            opacity: 1,
            y: 0,
            stagger: 0.15,
            duration: 1,
            ease: "power2.out"
        });
    }
    
    // Form submission handlers (basic client-side feedback)
    const forms = document.querySelectorAll('.ritual-form');
    forms.forEach(form => {
      form.addEventListener('submit', function(e) {
        const formId = form.id;
        const successEl = document.getElementById('success-' + formId.replace('contact-', ''));
        const errorEl = document.getElementById('error-' + formId.replace('contact-', ''));
        
        // Hide previous messages
        if (successEl) successEl.style.display = 'none';
        if (errorEl) errorEl.style.display = 'none';
        
        // Show success message after form submission (Shopify handles actual submission)
        setTimeout(() => {
          if (successEl) {
            successEl.textContent = 'Thank you! Your message has been sent. We\'ll be in touch soon.';
            successEl.style.display = 'block';
          }
        }, 100);
      });
    });
  });
</script>
