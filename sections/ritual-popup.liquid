{% schema %}
{
  "name": "Ritual Popup",
  "settings": [
    {
      "type": "textarea",
      "id": "popup_text",
      "label": "Message",
      "default": "Adornment is chosen, not rushed.\nMove slowly. Return when ready."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Enter"
    },
    {
        "type": "number",
        "id": "delay",
        "label": "Delay (seconds)",
        "default": 20
    }
  ],
  "presets": [
    {
      "name": "Ritual Popup"
    }
  ]
}
{% endschema %}

{% style %}
.ritual-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000; /* Fallback */
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.ritual-popup-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.ritual-popup-content {
  background-color: #fcfbf9;
  padding: 60px 40px;
  max-width: 500px;
  width: 90%;
  text-align: center;
  position: relative;
  transform: translateY(20px);
  transition: transform 0.5s ease;
  box-shadow: 0 10px 40px rgba(0,0,0,0.1);
}

.ritual-popup-overlay.active .ritual-popup-content {
  transform: translateY(0);
}

.popup-text {
  font-size: 1.4rem;
  font-weight: 300;
  line-height: 1.5;
  margin-bottom: 2rem;
  color: #333;
}

.popup-close-btn {
  display: inline-block;
  padding: 10px 30px;
  border: 1px solid #333;
  background: transparent;
  color: #333;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: all 0.3s ease;
}

.popup-close-btn:hover {
  background: #333;
  color: #fff;
}
{% endstyle %}

<div class="ritual-popup-overlay" id="ritualPopup">
  <div class="ritual-popup-content">
    <div class="popup-text">
        {{ section.settings.popup_text | newline_to_br }}
    </div>
    <button class="popup-close-btn" id="closePopupBtn">{{ section.settings.button_text }}</button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
      const popup = document.getElementById('ritualPopup');
      const closeBtn = document.getElementById('closePopupBtn');
      const delay = {{ section.settings.delay }} * 1000;
      let hasShown = sessionStorage.getItem('ritualPopupShown');

      function showPopup() {
          if (!hasShown) {
              popup.classList.add('active');
              sessionStorage.setItem('ritualPopupShown', 'true');
              hasShown = true;
          }
      }

      function closePopup() {
          popup.classList.remove('active');
      }

      // Timer Trigger
      setTimeout(showPopup, delay);

      // Exit Intent Trigger (Desktop only)
      document.addEventListener('mouseleave', (e) => {
          if (e.clientY < 0 && window.innerWidth > 768) {
              showPopup();
          }
      });

      closeBtn.addEventListener('click', closePopup);
      
      // Close on outside click
      popup.addEventListener('click', (e) => {
         if (e.target === popup) {
             closePopup();
         }
      });
  });
</script>
