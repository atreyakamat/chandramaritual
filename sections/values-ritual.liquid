{% schema %}
{
  "name": "Values Ritual",
  "settings": [],
  "blocks": [
    {
      "type": "value",
      "name": "Value Prop",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Renewed Metals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values Ritual",
      "blocks": [
        {
          "type": "value",
          "settings": { "title": "Renewed Metals" }
        },
        {
          "type": "value",
          "settings": { "title": "Female-Owned" }
        },
        {
          "type": "value",
          "settings": { "title": "Skilled Craftsmanship" }
        },
        {
          "type": "value",
          "settings": { "title": "Fusion Aesthetic" }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.values-ritual-section {
  padding: 60px 20px;
  background-color: #fcfbf9; /* Ivory background */
  text-align: center;
}

.values-grid {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.value-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200px;
  opacity: 0; /* GSAP initial state */
  transform: translateY(20px);
}

.icon-wrapper {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: #000; /* Placeholder black circle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  overflow: hidden;
}

.icon-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.value-title {
  font-size: 0.9rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #333;
}

@media (max-width: 768px) {
  .values-grid {
    gap: 30px;
  }
  .value-item {
    width: 45%; /* 2 per row on mobile */
  }
}
{% endstyle %}

<section class="values-ritual-section">
  <div class="values-grid">
    {% for block in section.blocks %}
      <div class="value-item">
        <div class="icon-wrapper">
          {% if block.settings.icon %}
            <img src="{{ block.settings.icon | image_url: width: 160 }}" 
                 alt="{{ block.settings.title | escape }}"
                 loading="lazy"
                 width="{{ block.settings.icon.width }}"
                 height="{{ block.settings.icon.height }}">
          {% else %}
             <!-- Placeholder circle if no image -->
             <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
               <circle cx="12" cy="12" r="10"></circle>
               <path d="M12 8v8M8 12h8"></path> <!-- Simple cross/star -->
             </svg>
          {% endif %}
        </div>
        <div class="value-title">{{ block.settings.title }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
       gsap.to(".value-item", {
         scrollTrigger: {
            trigger: ".values-grid",
            start: "top 85%"
         },
         opacity: 1,
         y: 0,
         stagger: 0.1,
         duration: 0.8,
         ease: "power2.out"
       });
    }
  });
</script>
