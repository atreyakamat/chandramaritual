{% schema %}
{
  "name": "Header Ritual",
  "class": "section-header-ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E6DBC6" 
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Icon Color",
      "default": "#333333"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ],
  "presets": [
    {
      "name": "Header Ritual"
    }
  ]
}
{% endschema %}

{% style %}
  :root {
    --header-ritual-bg: {{ section.settings.bg_color }};
    --header-ritual-text: {{ section.settings.text_color }};
  }

  .header-ritual-wrapper {
    background-color: var(--header-ritual-bg);
    padding: 15px 30px;
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: inherit; /* Inherit theme font */
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .header-ritual {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Left: Nav */
  .header-nav {
    display: flex;
    gap: 30px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .header-nav li a {
    text-decoration: none;
    color: var(--header-ritual-text);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    font-weight: 500;
    transition: opacity 0.3s;
  }

  .header-nav li a:hover {
    opacity: 0.7;
  }

  /* Center: Logo */
  .header-logo {
    display: flex;
    justify-content: center;
  }

  .header-logo img {
    object-fit: contain;
  }

  .header-logo-text {
    font-size: 1.5rem;
    font-weight: 300;
    text-decoration: none;
    color: var(--header-ritual-text);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  /* Right: Icons */
  .header-icons {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    align-items: center;
  }

  .icon-link {
    color: var(--header-ritual-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: opacity 0.3s;
  }

  .icon-link:hover {
    opacity: 0.7;
  }

  .icon-link svg {
    width: 22px;
    height: 22px;
  }

  /* Mobile */
  @media (max-width: 990px) {
    .header-ritual {
      grid-template-columns: auto 1fr auto;
      gap: 15px;
    }
    
    .header-nav {
      display: none; /* In a real implementation this would trigger a drawer */
    }

    .mobile-menu-trigger {
       display: block;
       color: var(--header-ritual-text);
       background: none;
       border: none;
       cursor: pointer;
    }
    
    .mobile-menu-trigger svg {
       width: 24px; 
       height: 24px;
    }
    
    .header-logo {
       justify-content: center;
    }
  }
  
  @media (min-width: 991px) {
     .mobile-menu-trigger {
        display: none;
     }
  }
{% endstyle %}

<header class="header-ritual-wrapper">
  <div class="header-ritual">
    
    <!-- Mobile Menu Trigger -->
    <button class="mobile-menu-trigger" aria-label="Menu">
       {% render 'icon-menu' %}
    </button>

    <!-- Desktop Nav -->
    <nav>
      <ul class="header-nav">
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <!-- Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" class="header-logo-link">
        {% if section.settings.logo != blank %}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag:
            class: 'header__heading-logo',
            widths: '50, 100, 150, 200, 250, 300, 400, 500',
            height: section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio,
            width: section.settings.logo_width,
            alt: logo_alt
          }}
        {% else %}
          <span class="header-logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Icons -->
    <div class="header-icons">
      <a href="{{ routes.search_url }}" class="icon-link" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      
      {% if shop.customer_accounts_enabled %}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="icon-link" aria-label="Account">
          {% render 'icon-account' %}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="icon-link" id="cart-icon-bubble" aria-label="Cart">
        {% render 'icon-cart' %}
      </a>
    </div>
  </div>
</header>

{% comment %}
  Ideally, we'd add the drawer component here for mobile. 
  For this artifact, we rely on the theme's existing drawer or keeping it simple.
{% endcomment %}
