{% comment %}
  Chandrama Ritual — Split Feature Section
  Inspired by Noir Kala editorial style
{% endcomment %}

{% schema %}
{
  "name": "Split Feature Ritual",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Jewellery for the Modern Mystic"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each piece is intentionally designed, hand-forged, and blessed—jewellery as sacred objects. We believe that true adornment begins within. Our pieces are not meant to announce—they invite.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0ede6"
    }
  ],
  "presets": [
    {
      "name": "Split Feature Ritual"
    }
  ]
}
{% endschema %}

<style>
.split-feature-ritual {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 80vh;
}

.split-feature-image {
  position: relative;
  overflow: hidden;
  {% if section.settings.image_position == 'right' %}order: 2;{% endif %}
}

.split-feature-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.split-feature-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px;
  background-color: {{ section.settings.bg_color }};
  {% if section.settings.image_position == 'right' %}order: 1;{% endif %}
}

.split-feature-eyebrow {
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8a7355;
  margin-bottom: 20px;
  font-weight: 500;
}

.split-feature-heading {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.8rem;
  font-weight: 300;
  line-height: 1.2;
  margin-bottom: 30px;
  color: #1a1a1a;
  text-transform: none;
  letter-spacing: 0;
}

.split-feature-text {
  font-size: 1.05rem;
  line-height: 1.8;
  color: #555;
  margin-bottom: 40px;
  font-weight: 300;
  max-width: 500px;
}

.split-feature-btn {
  display: inline-block;
  padding: 16px 40px;
  background: #1a1a1a;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.8rem;
  transition: all 0.3s ease;
  align-self: flex-start;
}

.split-feature-btn:hover {
  background: #333;
}

@media (max-width: 900px) {
  .split-feature-ritual {
    grid-template-columns: 1fr;
  }
  
  .split-feature-image {
    min-height: 50vh;
    order: 1 !important;
  }
  
  .split-feature-content {
    padding: 60px 30px;
    order: 2 !important;
  }
  
  .split-feature-heading {
    font-size: 2rem;
  }
}
</style>

<section class="split-feature-ritual">
  <div class="split-feature-image">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" 
           alt="{{ section.settings.heading | escape }}"
           loading="lazy">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  
  <div class="split-feature-content">
    {% if section.settings.eyebrow != blank %}
      <div class="split-feature-eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    
    <h2 class="split-feature-heading">{{ section.settings.heading }}</h2>
    
    <div class="split-feature-text">
      {{ section.settings.text }}
    </div>
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url | default: '/pages/about' }}" class="split-feature-btn">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    gsap.from(".split-feature-image img", {
      scrollTrigger: { trigger: ".split-feature-ritual", start: "top 70%" },
      scale: 1.1,
      duration: 1.5,
      ease: "power2.out"
    });
    
    gsap.from(".split-feature-content > *", {
      scrollTrigger: { trigger: ".split-feature-ritual", start: "top 60%" },
      opacity: 0,
      y: 30,
      stagger: 0.15,
      duration: 0.8,
      ease: "power2.out"
    });
  }
});
</script>
