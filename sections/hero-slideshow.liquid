{% schema %}
{
  "name": "Hero Slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Adornment as devotion."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Jewelry as remembrance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  .hero-slideshow {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background-color: #fcfbf9; /* Ivory/Off-white */
  }

  .slide {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .slide-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff; /* Assuming white text on hero images, adjustable */
    padding: 20px;
  }

  .slide-content h1 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .slide-content p {
    font-size: 1.25rem;
    font-weight: 300;
    margin-bottom: 2rem;
    letter-spacing: 0.02em;
  }

  .cta {
    display: inline-block;
    padding: 12px 24px;
    background-color: transparent;
    border: 1px solid currentColor;
    color: currentColor;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    transition: opacity 0.3s ease;
  }

  .cta:hover {
    opacity: 0.8;
  }
  
  @media (max-width: 768px) {
    .hero-slideshow {
        height: 70vh; /* Reduced height on mobile */
    }
    .slide-content h1 {
        font-size: 2rem;
    }
  }
{% endstyle %}

<section class="hero-slideshow">
  <div class="slides">
    {% for block in section.blocks %}
      <div class="slide">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
            alt="{{ block.settings.image.alt | escape }}"
          >
        {% else %}
           {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
        
        <div class="slide-content">
          <h1>{{ block.settings.heading }}</h1>
          <p>{{ block.settings.subtext }}</p>
          <a href="/collections/all" class="cta">Explore the ritual</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    // Check if GSAP is loaded
    if (typeof gsap !== 'undefined') {
       const slides = document.querySelectorAll('.hero-slideshow .slide');
       
       // Only run animation on the first slide initially or handle logic for multiple slides
       // For this MVP blueprint, we animate the content generally as it enters
       
      gsap.from(".slide-content h1", {
        y: 40,
        opacity: 0,
        duration: 1.2,
        ease: "power2.out"
      });

      gsap.from(".slide-content p", {
        y: 30,
        opacity: 0,
        delay: 0.2,
        duration: 1,
        ease: "power2.out"
      });
      
      // Mobile Optimization: Static hero image, Text fade-in only logic is handled by GSAP media queries 
      // or simply rely on the 'from' which provides the fade-in.
      // The prompt asks to "Disable slide autoplay" explicitly for mobile, but this is a static structure layout currently.
      // If we add a slider library later, we'd add that logic here.
    }
  });
</script>
