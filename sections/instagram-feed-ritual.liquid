{% schema %}
{
  "name": "Instagram Feed Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "@chandramaritual",
      "info": "e.g., @yourbrand"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL",
      "default": "https://instagram.com/chandramaritual"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Follow Us"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Instagram Post URL (Optional)",
          "info": "Link to the actual Instagram post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed Ritual",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.instagram-feed-section {
  padding: 80px 0;
  text-align: center;
}

.instagram-header {
  margin-bottom: 50px;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.instagram-heading {
  font-size: 2rem;
  font-weight: 300;
  margin-bottom: 15px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #1a1a1a;
}

.instagram-handle {
  font-size: 1.1rem;
  color: #555;
  font-weight: 300;
  margin-bottom: 30px;
}

.instagram-handle a {
  color: inherit;
  text-decoration: none;
  transition: opacity 0.3s;
}

.instagram-handle a:hover {
  opacity: 0.7;
}

.instagram-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 15px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.instagram-post {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: #f5f5f5;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.instagram-post img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.instagram-post:hover img {
  transform: scale(1.08);
}

.instagram-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instagram-post:hover .instagram-overlay {
  opacity: 1;
}

.instagram-icon {
  width: 40px;
  height: 40px;
  fill: white;
}

.instagram-cta {
  display: inline-block;
  margin-top: 50px;
  padding: 15px 40px;
  background: #1a1a1a;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.85rem;
  transition: background 0.3s, transform 0.2s;
  font-weight: 500;
  opacity: 0; /* GSAP */
}

.instagram-cta:hover {
  background: #333;
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .instagram-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  
  .instagram-heading {
    font-size: 1.5rem;
  }
}

@media (min-width: 769px) and (max-width: 1024px) {
  .instagram-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1025px) {
  .instagram-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
{% endstyle %}

<section class="instagram-feed-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="instagram-header">
    <h2 class="instagram-heading">{{ section.settings.heading }}</h2>
    <div class="instagram-handle">
      <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
        {{ section.settings.instagram_handle }}
      </a>
    </div>
  </div>

  <div class="instagram-grid">
    {% for block in section.blocks %}
      {% if block.settings.image %}
        <a 
          href="{{ block.settings.post_url | default: section.settings.instagram_url }}" 
          class="instagram-post"
          target="_blank"
          rel="noopener"
          {{ block.shopify_attributes }}
        >
          <img 
            src="{{ block.settings.image | image_url: width: 500 }}" 
            alt="Instagram post"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
          <div class="instagram-overlay">
            <svg class="instagram-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <a href="{{ section.settings.instagram_url }}" class="instagram-cta" target="_blank" rel="noopener">
    {{ section.settings.cta_text }}
  </a>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        const section = document.querySelector('.instagram-feed-section');
        
        // Header Animation
        gsap.to(".instagram-header", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out"
        });
        
        // Grid Stagger
        gsap.to(".instagram-post", {
            scrollTrigger: {
                trigger: ".instagram-grid",
                start: "top 80%"
            },
            opacity: 1,
            y: 0,
            stagger: 0.08,
            duration: 0.8,
            ease: "power2.out"
        });
        
        // CTA
        gsap.to(".instagram-cta", {
            scrollTrigger: {
                trigger: ".instagram-grid",
                start: "top 60%"
            },
            opacity: 1,
            duration: 1,
            delay: 0.5,
            ease: "power2.out"
        });
    }
  });
</script>
