{% schema %}
{
  "name": "Bestsellers Ritual",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Offerings"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
       "type": "range",
       "id": "products_to_show",
       "min": 4,
       "max": 12,
       "step": 4,
       "default": 4,
       "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.bestsellers-ritual {
  padding: 80px 20px;
  background-color: #fcfbf9;
}

.section-header {
  text-align: center;
  margin-bottom: 50px;
}

.section-header h2 {
  font-size: 1.5rem;
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.product-grid-ritual {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 40px;
  max-width: 1400px;
  margin: 0 auto;
}

.product-card-ritual {
  opacity: 0; /* GSAP initial state */
  transform: translateY(20px);
}

.product-card-ritual a {
  text-decoration: none;
  color: #333;
}

.product-image-wrapper {
  position: relative;
  aspect-ratio: 1 / 1.25;
  overflow: hidden;
  margin-bottom: 15px;
}

.product-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card-ritual:hover img {
  transform: scale(1.03);
}

.product-info h3 {
  font-size: 1rem;
  font-weight: 400;
  margin: 0 0 5px;
}

.product-info .price {
  font-size: 0.9rem;
  color: #666;
}

.view-all-btn {
  display: block;
  width: fit-content;
  margin: 60px auto 0;
  text-decoration: underline;
  text-underline-offset: 4px;
  color: #333;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.9rem;
}
{% endstyle %}

<section class="bestsellers-ritual">
  <div class="section-header">
    <h2>{{ section.settings.title }}</h2>
  </div>

  <div class="product-grid-ritual">
    {% assign collection = section.settings.collection %}
    {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="product-card-ritual">
        <a href="{{ product.url }}">
          <div class="product-image-wrapper">
             {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" 
                     alt="{{ product.title | escape }}"
                     loading="lazy"
                     width="{{ product.featured_image.width }}"
                     height="{{ product.featured_image.height }}">
             {% else %}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag }}
             {% endif %}
          </div>
          <div class="product-info">
            <h3>{{ product.title }}</h3>
            <span class="price">{{ product.price | money }}</span>
          </div>
        </a>
      </div>
    {% else %}
       {% for i in (1..4) %}
         <div class="product-card-ritual">
            <div class="product-image-wrapper">
               {{ 'product-' | append: i | placeholder_svg_tag }}
            </div>
            <div class="product-info">
               <h3>Product Title</h3>
               <span class="price">$100.00</span>
            </div>
         </div>
       {% endfor %}
    {% endfor %}
  </div>

  <a href="{{ collection.url | default: '/collections/all' }}" class="view-all-btn">View pieces</a>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
       gsap.to(".product-card-ritual", {
         scrollTrigger: {
            trigger: ".product-grid-ritual",
            start: "top 80%"
         },
         opacity: 1,
         y: 0,
         stagger: 0.15,
         duration: 1,
         ease: "power2.out"
       });
    }
  });
</script>
