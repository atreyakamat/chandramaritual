{% schema %}
{
  "name": "Trust Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Duration (s)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description text here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Marquee",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "heading": "EXTENDED 1-YEAR WARRANTY",
            "text": "We’re committed to the best. Delight in the benefits of an extended 1-year warranty."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "heading": "30-DAYS EXCHANGES",
            "text": "We gladly accept returns for exchanges or gift-card within a delay of 30 days."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "heading": "WORLDWIDE FREE SHIPPINGS",
            "text": "Orders over $200 qualify for free shipping!"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.trust-marquee-section {
  padding: 40px 0;
  overflow: hidden;
  white-space: nowrap;
}

.trust-track {
  display: flex;
  width: fit-content;
  animation: scroll-trust {{ section.settings.speed }}s linear infinite;
}

.trust-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 300px; /* Fixed width for better marquee spacing */
  margin: 0 40px;
  white-space: normal; /* Allow text wrapping inside item */
  vertical-align: top;
}

.trust-icon {
  width: 50px;
  height: 50px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.trust-heading {
  font-size: 0.9rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.trust-text {
  font-size: 0.8rem;
  font-weight: 300;
  line-height: 1.4;
  opacity: 0.8;
}

@keyframes scroll-trust {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); } /* Assumes track is duplicated once */
}

/* Mobile: On very small screens, marquee persists. 
   Optionally could stack, but request was "marqueee" */
{% endstyle %}

<section class="trust-marquee-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="trust-track">
    <!-- Duplicate content significantly to ensure seamless loop without JS complex cloning if possible, 
         or use Liquid loop twice.
    -->
    {% for i in (1..6) %} <!-- Repeat sufficient times to fill wide screens if few items -->
        {% for block in section.blocks %}
          <div class="trust-item">
            <div class="trust-icon">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url: width: 100 }}" 
                     loading="lazy" 
                     width="{{ block.settings.icon.width }}" 
                     height="{{ block.settings.icon.height }}" 
                     alt="{{ block.settings.heading | escape }}">
              {% else %}
                 <!-- Gold placeholder circle -->
                 <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                   <circle cx="12" cy="12" r="10"></circle>
                   <path d="M12 8v8M8 12h8"></path>
                 </svg>
              {% endif %}
            </div>
            <div class="trust-heading">{{ block.settings.heading }}</div>
            <div class="trust-text">{{ block.settings.text }}</div>
          </div>
        {% endfor %}
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        gsap.from(".trust-marquee-section", {
          scrollTrigger: {
              trigger: ".trust-marquee-section",
              start: "top 90%"
          },
          opacity: 0,
          y: 20,
          duration: 1,
          ease: "power2.out"
        });
    }
  });

  // Hover pause mechanism
  document.querySelector('.trust-marquee-section').addEventListener('mouseenter', () => {
     document.querySelector('.trust-track').style.animationPlayState = 'paused';
  });
  document.querySelector('.trust-marquee-section').addEventListener('mouseleave', () => {
     document.querySelector('.trust-track').style.animationPlayState = 'running';
  });
</script>
