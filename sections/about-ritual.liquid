{% schema %}
{
  "name": "About Page Ritual",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ABOUT CHANDRAMA RITUAL"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Chandrama—meaning \"moon\" in Sanskrit—is more than a name. It is an invitation to move with lunar rhythms, to honor the cyclical nature of being, to celebrate the body as a living altar.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "richtext",
      "id": "philosophy",
      "label": "Our Philosophy",
      "default": "<p>We believe that true adornment begins within. Our pieces are not meant to announce—they invite. They whisper rather than shout. They honor the feminine power that doesn't need to be seen to be felt.</p>"
    },
    {
      "type": "richtext",
      "id": "materials",
      "label": "Our Materials",
      "default": "<p>We work exclusively with recycled precious metals, ethically sourced gemstones, and sacred intention. Each stone is cleansed, each piece is blessed, and every design is created to honor the body it adorns.</p>"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Handcrafted with intention"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page Ritual",
      "blocks": [
        { "type": "value", "settings": { "title": "Handcrafted with intention and care" } },
        { "type": "value", "settings": { "title": "Ethically sourced from responsible suppliers" } },
        { "type": "value", "settings": { "title": "Designed for ritual — meditation, moon ceremonies, or daily life" } },
        { "type": "value", "settings": { "title": "Created for longevity — heirloom quality, not fast fashion" } }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.about-ritual-section {
  padding: 100px 40px;
  background-color: #faf9f6;
}

.about-ritual-container {
  max-width: 1200px;
  margin: 0 auto;
}

.about-ritual-heading {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 300;
  letter-spacing: 0.15em;
  margin-bottom: 60px;
  opacity: 0;
  transform: translateY(30px);
}

.about-ritual-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  margin-bottom: 80px;
}

.about-ritual-image {
  opacity: 0;
  transform: translateX(-30px);
}

.about-ritual-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.about-ritual-content {
  opacity: 0;
  transform: translateX(30px);
}

.about-ritual-intro {
  font-size: 1.2rem;
  line-height: 1.7;
  margin-bottom: 40px;
  color: #333;
  font-weight: 300;
}

.about-section-title {
  font-size: 1.2rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 20px;
  color: #8a7355;
}

.about-section-text {
  font-size: 1rem;
  line-height: 1.7;
  color: #555;
  font-weight: 300;
  margin-bottom: 40px;
}

.about-values-list {
  list-style: none;
  padding: 0;
  margin: 30px 0 0;
}

.about-values-list li {
  padding: 15px 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  font-size: 0.95rem;
  color: #333;
  display: flex;
  align-items: center;
  gap: 15px;
}

.about-values-list li::before {
  content: "✦";
  color: #8a7355;
}

@media (max-width: 900px) {
  .about-ritual-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .about-ritual-heading {
    font-size: 2rem;
  }
}
{% endstyle %}

<section class="about-ritual-section">
  <div class="about-ritual-container">
    <h1 class="about-ritual-heading">{{ section.settings.heading }}</h1>
    
    <div class="about-ritual-grid">
      <div class="about-ritual-image">
        {% if section.settings.image %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" 
               alt="{{ section.settings.heading | escape }}"
               loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      
      <div class="about-ritual-content">
        <div class="about-ritual-intro">
          {{ section.settings.intro }}
        </div>
        
        <h3 class="about-section-title">Our Philosophy</h3>
        <div class="about-section-text">
          {{ section.settings.philosophy }}
        </div>
        
        <ul class="about-values-list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>{{ block.settings.title }}</li>
          {% endfor %}
        </ul>
        
        <h3 class="about-section-title" style="margin-top: 40px;">Our Materials</h3>
        <div class="about-section-text">
          {{ section.settings.materials }}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== 'undefined') {
      gsap.to(".about-ritual-heading", { opacity: 1, y: 0, duration: 1, ease: "power2.out" });
      gsap.to(".about-ritual-image", { opacity: 1, x: 0, duration: 1, delay: 0.3, ease: "power2.out" });
      gsap.to(".about-ritual-content", { opacity: 1, x: 0, duration: 1, delay: 0.5, ease: "power2.out" });
    }
  });
</script>
