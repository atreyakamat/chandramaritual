{% comment %}
  Chandrama Ritual — Premium Header
  Inspired by Nakila Collective + Noir Kala
{% endcomment %}

{% schema %}
{
  "name": "Header Ritual Premium",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 200,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent Header on Homepage",
      "default": true
    }
  ]
}
{% endschema %}

<style>
.header-ritual-premium {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: all 0.4s ease;
}

.header-ritual-premium.transparent {
  background: transparent;
}

.header-ritual-premium.scrolled,
.header-ritual-premium:not(.transparent) {
  background: #E6DBC6;
  box-shadow: 0 2px 20px rgba(0,0,0,0.08);
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  max-width: 1600px;
  margin: 0 auto;
}

/* Navigation */
.header-nav {
  display: flex;
  gap: 40px;
}

.header-nav a {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  text-decoration: none;
  color: #1a1a1a;
  font-weight: 400;
  transition: opacity 0.3s;
}

.transparent .header-nav a {
  color: #fff;
}

.scrolled .header-nav a {
  color: #1a1a1a;
}

.header-nav a:hover {
  opacity: 0.6;
}

/* Logo */
.header-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.header-logo img {
  height: auto;
  max-width: {{ section.settings.logo_width }}px;
  transition: filter 0.3s;
}

.transparent .header-logo img {
  filter: brightness(0) invert(1);
}

.scrolled .header-logo img {
  filter: none;
}

.header-logo-text {
  font-size: 1.5rem;
  font-weight: 300;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-decoration: none;
  color: #1a1a1a;
}

.transparent .header-logo-text {
  color: #fff;
}

/* Icons */
.header-icons {
  display: flex;
  gap: 25px;
  align-items: center;
}

.header-icon {
  position: relative;
  color: #1a1a1a;
  transition: opacity 0.3s;
}

.transparent .header-icon {
  color: #fff;
}

.scrolled .header-icon {
  color: #1a1a1a;
}

.header-icon:hover {
  opacity: 0.6;
}

.header-icon svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.5;
}

.cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 18px;
  height: 18px;
  background: #8a7355;
  color: #fff;
  border-radius: 50%;
  font-size: 0.65rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Mobile Menu */
.mobile-menu-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
}

.mobile-menu-toggle svg {
  width: 24px;
  height: 24px;
  stroke: currentColor;
  stroke-width: 1.5;
}

@media (max-width: 900px) {
  .header-nav {
    display: none;
  }
  
  .mobile-menu-toggle {
    display: block;
  }
  
  .header-inner {
    padding: 15px 20px;
  }
  
  .header-logo {
    position: static;
    transform: none;
  }
}

/* Mobile Menu Drawer */
.mobile-menu-drawer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #E6DBC6;
  z-index: 2000;
  transform: translateX(-100%);
  transition: transform 0.4s ease;
  display: flex;
  flex-direction: column;
  padding: 80px 40px 40px;
}

.mobile-menu-drawer.open {
  transform: translateX(0);
}

.mobile-menu-close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
}

.mobile-menu-drawer a {
  font-size: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  text-decoration: none;
  color: #1a1a1a;
  padding: 20px 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
  display: block;
}
</style>

<header class="header-ritual-premium {% if section.settings.transparent_header and request.page_type == 'index' %}transparent{% endif %}">
  <div class="header-inner">
    
    <!-- Left: Navigation -->
    <nav class="header-nav">
      {% for link in linklists[section.settings.menu].links limit: 4 %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    
    <!-- Center: Logo -->
    <a href="/" class="header-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
      {% else %}
        <span class="header-logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
    
    <!-- Right: Icons -->
    <div class="header-icons">
      <a href="/search" class="header-icon" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      
      <a href="/account" class="header-icon" aria-label="Account">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      
      <a href="/cart" class="header-icon" aria-label="Cart">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      
      <button class="mobile-menu-toggle header-icon" aria-label="Menu">
        <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div class="mobile-menu-drawer">
  <button class="mobile-menu-close">&times;</button>
  {% for link in linklists[section.settings.menu].links %}
    <a href="{{ link.url }}">{{ link.title }}</a>
  {% endfor %}
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const header = document.querySelector('.header-ritual-premium');
  const mobileToggle = document.querySelector('.mobile-menu-toggle');
  const mobileDrawer = document.querySelector('.mobile-menu-drawer');
  const mobileClose = document.querySelector('.mobile-menu-close');
  
  // Scroll behavior
  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      header.classList.add('scrolled');
      header.classList.remove('transparent');
    } else {
      header.classList.remove('scrolled');
      if (header.dataset.transparent === 'true') {
        header.classList.add('transparent');
      }
    }
  });
  
  // Mobile menu
  if (mobileToggle && mobileDrawer) {
    mobileToggle.addEventListener('click', () => mobileDrawer.classList.add('open'));
    mobileClose.addEventListener('click', () => mobileDrawer.classList.remove('open'));
  }
});
</script>
