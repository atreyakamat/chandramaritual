{% comment %}
  Chandrama Ritual — Video Banner Section
  Inspired by luxury jewelry sites
{% endcomment %}

{% schema %}
{
  "name": "Video Banner Ritual",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External Video URL (YouTube/Vimeo)",
      "info": "Use if not uploading directly"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster Image (fallback)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sacred Adornment"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Handcrafted with intention"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Video Banner Ritual"
    }
  ]
}
{% endschema %}

<style>
.video-banner-ritual {
  position: relative;
  height: 70vh;
  min-height: 500px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.video-banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: 2;
}

.video-banner-content {
  position: relative;
  z-index: 3;
  text-align: center;
  color: #fff;
  padding: 40px;
}

.video-banner-heading {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 3.5rem;
  font-weight: 300;
  margin-bottom: 20px;
  text-transform: none;
  letter-spacing: 0.02em;
}

.video-banner-subtext {
  font-size: 1.1rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 40px;
  opacity: 0.9;
}

.video-banner-btn {
  display: inline-block;
  padding: 18px 50px;
  background: transparent;
  color: #fff;
  border: 1px solid #fff;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.8rem;
  transition: all 0.3s;
}

.video-banner-btn:hover {
  background: #fff;
  color: #1a1a1a;
}

@media (max-width: 768px) {
  .video-banner-heading {
    font-size: 2.5rem;
  }
}
</style>

<section class="video-banner-ritual">
  {% if section.settings.video %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'video-banner-bg' }}
  {% elsif section.settings.poster %}
    <img class="video-banner-bg" src="{{ section.settings.poster | image_url: width: 2000 }}" alt="">
  {% else %}
    <div class="video-banner-bg" style="background: linear-gradient(135deg, #5c4a3d, #1a1a1a);"></div>
  {% endif %}
  
  <div class="video-banner-overlay"></div>
  
  <div class="video-banner-content">
    {% if section.settings.heading != blank %}
      <h2 class="video-banner-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.subtext != blank %}
      <p class="video-banner-subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url | default: '#' }}" class="video-banner-btn">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>
