{% schema %}
{
  "name": "Stone Meaning Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f3ef"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE RITUAL OF STONES"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Introduction Text",
      "default": "Each stone carries its own energy, intention, and ancient wisdom. Discover the meanings behind our carefully selected gemstones."
    }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Stone",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Stone Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Stone Name",
          "default": "Moonstone"
        },
        {
          "type": "textarea",
          "id": "meaning",
          "label": "Meaning & Intention",
          "default": "Intuition • Feminine Energy • New Beginnings"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Connected to the moon's cycles, moonstone enhances intuition and promotes inner growth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stone Meaning Ritual",
      "blocks": [
        {
          "type": "stone",
          "settings": {
            "name": "Moonstone",
            "meaning": "Intuition • Feminine Energy • New Beginnings",
            "description": "Connected to the moon's cycles, moonstone enhances intuition and promotes inner growth."
          }
        },
        {
          "type": "stone",
          "settings": {
            "name": "Rose Quartz",
            "meaning": "Love • Compassion • Emotional Healing",
            "description": "The stone of unconditional love, rose quartz opens the heart to deep inner healing."
          }
        },
        {
          "type": "stone",
          "settings": {
            "name": "Lapis Lazuli",
            "meaning": "Wisdom • Truth • Self-Expression",
            "description": "A stone of ancient royalty, lapis lazuli awakens the third eye and enhances spiritual insight."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.stone-meaning-section {
  padding: 100px 40px;
}

.stone-meaning-intro {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 80px;
}

.stone-meaning-heading {
  font-size: 2.5rem;
  font-weight: 300;
  margin-bottom: 30px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  opacity: 0; /* GSAP */
  transform: translateY(30px);
}

.stone-meaning-intro-text {
  font-size: 1.1rem;
  line-height: 1.6;
  opacity: 0.8;
  font-weight: 300;
  opacity: 0; /* GSAP */
  transform: translateY(20px);
}

.stones-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 50px;
  max-width: 1400px;
  margin: 0 auto;
}

.stone-card {
  text-align: center;
  opacity: 0; /* GSAP */
  transform: translateY(30px);
}

.stone-image-wrapper {
  width: 200px;
  height: 200px;
  margin: 0 auto 30px;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.08);
}

.stone-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.stone-card:hover .stone-image-wrapper img {
  transform: scale(1.1);
}

.stone-name {
  font-size: 1.3rem;
  font-weight: 400;
  margin-bottom: 15px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #1a1a1a;
}

.stone-meaning {
  font-size: 0.85rem;
  margin-bottom: 20px;
  color: #8a7355;
  letter-spacing: 0.1em;
  font-weight: 500;
}

.stone-description {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #555;
  font-weight: 300;
}

@media (max-width: 768px) {
  .stones-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
  
  .stone-meaning-heading {
    font-size: 2rem;
  }
}
{% endstyle %}

<section class="stone-meaning-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="stone-meaning-intro">
    <h2 class="stone-meaning-heading">{{ section.settings.heading }}</h2>
    <p class="stone-meaning-intro-text">{{ section.settings.intro_text }}</p>
  </div>

  <div class="stones-grid">
    {% for block in section.blocks %}
      <div class="stone-card" {{ block.shopify_attributes }}>
        <div class="stone-image-wrapper">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 400 }}" 
                 alt="{{ block.settings.name | escape }}"
                 loading="lazy"
                 width="{{ block.settings.image.width }}"
                 height="{{ block.settings.image.height }}">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        
        <h3 class="stone-name">{{ block.settings.name }}</h3>
        <div class="stone-meaning">{{ block.settings.meaning }}</div>
        <p class="stone-description">{{ block.settings.description }}</p>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        const section = document.querySelector('.stone-meaning-section');
        
        // Heading Animation
        gsap.to(".stone-meaning-heading", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out"
        });
        
        gsap.to(".stone-meaning-intro-text", {
            scrollTrigger: {
                trigger: section,
                start: "top 75%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            delay: 0.2,
            ease: "power2.out"
        });
        
        // Stone Cards Stagger
        gsap.to(".stone-card", {
            scrollTrigger: {
                trigger: ".stones-grid",
                start: "top 80%"
            },
            opacity: 1,
            y: 0,
            stagger: 0.15,
            duration: 1,
            ease: "power2.out"
        });
    }
  });
</script>
