{% comment %}
  Chandrama Ritual — Featured Products Premium
  Hybrid design with hover actions
{% endcomment %}

{% schema %}
{
  "name": "Featured Products Premium",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "View All Button Text",
      "default": "View All"
    }
  ],
  "presets": [
    {
      "name": "Featured Products Premium"
    }
  ]
}
{% endschema %}

<style>
.featured-products-premium {
  padding: 100px 40px;
  background: #fff;
}

.featured-products-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1400px;
  margin: 0 auto 60px;
}

.featured-products-heading {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.5rem;
  font-weight: 300;
  color: #1a1a1a;
  text-transform: none;
  letter-spacing: 0;
  margin: 0;
}

.featured-products-viewall {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  text-decoration: none;
  color: #1a1a1a;
  border-bottom: 1px solid #1a1a1a;
  padding-bottom: 5px;
  transition: opacity 0.3s;
}

.featured-products-viewall:hover {
  opacity: 0.6;
}

.featured-products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  max-width: 1400px;
  margin: 0 auto;
}

.featured-product-card {
  position: relative;
}

.featured-product-image {
  position: relative;
  aspect-ratio: 9/16;
  overflow: hidden;
  margin-bottom: 20px;
  background: #f5f3ef;
}

.featured-product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.featured-product-card:hover .featured-product-image img {
  transform: scale(1.05);
}

/* Hover Actions */
.featured-product-actions {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.featured-product-card:hover .featured-product-actions {
  opacity: 1;
}

.fpa-btn {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.75);
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
}

.fpa-btn:hover {
  background: #1a1a1a;
  transform: translateY(-3px);
}

.fpa-btn svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.fpa-tooltip {
  position: absolute;
  bottom: 55px;
  left: 50%;
  transform: translateX(-50%);
  background: #000;
  color: #fff;
  padding: 5px 10px;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.fpa-btn:hover .fpa-tooltip {
  opacity: 1;
}

.featured-product-title {
  font-size: 0.9rem;
  font-weight: 400;
  text-align: center;
  margin-bottom: 8px;
}

.featured-product-title a {
  color: #333;
  text-decoration: none;
}

.featured-product-price {
  text-align: center;
  font-size: 0.95rem;
  color: #8a7355;
  font-weight: 400;
}

@media (max-width: 1024px) {
  .featured-products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .featured-products-premium {
    padding: 60px 20px;
  }
  
  .featured-products-header {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
  
  .featured-products-heading {
    font-size: 2rem;
  }
  
  .featured-products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}
</style>

<section class="featured-products-premium">
  <div class="featured-products-header">
    <h2 class="featured-products-heading">{{ section.settings.heading }}</h2>
    
    {% if section.settings.button_text != blank %}
      <a href="{{ collections[section.settings.collection].url | default: '/collections/all' }}" class="featured-products-viewall">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
  
  <div class="featured-products-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% for product in collection.products limit: section.settings.products_count %}
      <div class="featured-product-card">
        <div class="featured-product-image">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" 
                   alt="{{ product.title | escape }}"
                   loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
          </a>
          
          <div class="featured-product-actions">
            <button class="fpa-btn" onclick="event.preventDefault();">
              <span class="fpa-tooltip">Wishlist</span>
              <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </button>
            
            <button class="fpa-btn" onclick="if(window.quickShop)window.quickShop.open({title:'{{ product.title | escape }}',price:'{{ product.price | money }}',image:'{{ product.featured_image | image_url: width: 800 }}',url:'{{ product.url }}'})">
              <span class="fpa-tooltip">Quick View</span>
              <svg viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
            
            <button class="fpa-btn" data-variant="{{ product.variants.first.id }}">
              <span class="fpa-tooltip">Add to Cart</span>
              <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </button>
          </div>
        </div>
        
        <h3 class="featured-product-title">
          <a href="{{ product.url }}">{{ product.title }}</a>
        </h3>
        <div class="featured-product-price">{{ product.price | money }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    gsap.from(".featured-product-card", {
      scrollTrigger: { trigger: ".featured-products-grid", start: "top 85%" },
      opacity: 0,
      y: 40,
      stagger: 0.1,
      duration: 0.8,
      ease: "power2.out"
    });
  }
});
</script>
