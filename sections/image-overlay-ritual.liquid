{% schema %}
{
  "name": "Image Overlay Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0ede6"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CELEBRATE YOUR FEMININE ENERGY"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Each handcrafted piece is more than jewelry; it's a celebration of womanhood, meticulously crafted to honor the divine energy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_front",
      "label": "Front Image (Left)"
    },
    {
      "type": "image_picker",
      "id": "image_back",
      "label": "Back Image (Right)"
    }
  ],
  "presets": [
    {
      "name": "Image Overlay Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.overlay-ritual-section {
  padding: 100px 40px;
  overflow: hidden;
}

.overlay-ritual-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1300px;
  margin: 0 auto;
  gap: 60px;
}

.overlay-content {
  flex: 1;
  max-width: 500px;
  opacity: 0; /* GSAP */
  transform: translateY(30px);
}

.overlay-content h2 {
  font-size: 3rem;
  font-weight: 300;
  line-height: 1.1;
  margin-bottom: 30px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #1a1a1a;
}

.overlay-content p {
  font-size: 1.1rem;
  line-height: 1.6;
  margin-bottom: 40px;
  color: #4a4a4a;
  font-weight: 300;
}

.overlay-btn {
  display: inline-block;
  padding: 15px 40px;
  border: 1px solid #1a1a1a;
  color: #1a1a1a;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.9rem;
  transition: all 0.3s ease;
  background: transparent;
}

.overlay-btn:hover {
  background: #1a1a1a;
  color: #fff;
}

.overlay-images {
  flex: 1;
  position: relative;
  height: 600px; /* Adjust based on asset ratio */
  display: flex;
  align-items: center;
}

.img-wrapper {
  position: absolute;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  opacity: 0; /* GSAP */
}

.img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Front Image (Left, Lower) */
.img-front {
  width: 350px;
  height: 480px;
  left: 0;
  bottom: 0px;
  z-index: 2;
  transform: translateY(50px); /* GSAP Start */
}

/* Back Image (Right, Upper) */
.img-back {
  width: 400px;
  height: 550px;
  right: 0;
  top: 0;
  z-index: 1;
  transform: translateY(-30px); /* GSAP Start */
}

@media (max-width: 990px) {
  .overlay-ritual-container {
    flex-direction: column;
    text-align: center;
  }
  
  .overlay-content {
    margin-bottom: 60px;
  }
  
  .overlay-content h2 {
    font-size: 2.2rem;
  }
  
  .overlay-images {
    width: 100%;
    height: 500px;
  }
  
  .img-front {
    width: 55%;
    height: auto;
    aspect-ratio: 3/4;
    left: 5%;
  }
  
  .img-back {
    width: 60%;
    height: auto;
    aspect-ratio: 3/4;
    right: 5%;
  }
}
{% endstyle %}

<section class="overlay-ritual-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="overlay-ritual-container">
    
    <div class="overlay-content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a href="{{ section.settings.button_link | default: '#' }}" class="overlay-btn">
        {{ section.settings.button_label }}
      </a>
    </div>

    <div class="overlay-images">
      <div class="img-wrapper img-back">
        {% if section.settings.image_back %}
          <img src="{{ section.settings.image_back | image_url: width: 800 }}" 
               alt="" 
               loading="lazy"
               width="{{ section.settings.image_back.width }}"
               height="{{ section.settings.image_back.height }}">
        {% else %}
           {{ 'lifestyle-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
      
      <div class="img-wrapper img-front">
        {% if section.settings.image_front %}
          <img src="{{ section.settings.image_front | image_url: width: 700 }}" 
               alt="" 
               loading="lazy"
               width="{{ section.settings.image_front.width }}"
               height="{{ section.settings.image_front.height }}">
        {% else %}
           {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        const section = document.querySelector('.overlay-ritual-section');
        
        // Text Animation
        gsap.to(".overlay-content", {
            scrollTrigger: {
                trigger: section,
                start: "top 70%"
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out"
        });

        // Images Animation (Parallax-ish entrance)
        gsap.to(".img-back", {
            scrollTrigger: {
                trigger: section,
                start: "top 70%",
                scrub: 1 // Subtle scrub effect
            },
            opacity: 1,
            y: 0, // Moves to natural position from CSS transform
            duration: 1.5,
            ease: "power2.out"
        });
        
        // Front image comes in slightly faster/different for depth
        gsap.to(".img-front", {
            scrollTrigger: {
                trigger: section,
                start: "top 60%"
            },
            opacity: 1,
            y: 0, 
            duration: 1.2,
            ease: "power2.out"
        });
    }
  });
</script>
