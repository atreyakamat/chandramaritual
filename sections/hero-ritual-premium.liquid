{% comment %}
  Chandrama Ritual — Premium Hero Section
  Hybrid inspired by Noir Kala, Nakila, Hips Like Honey
{% endcomment %}

{% schema %}
{
  "name": "Hero Ritual Premium",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Adorn Your Ritual"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Handcrafted jewellery for the soul who moves with the moon's phases. Each piece is a sacred object, created for those who honor shadow as much as light."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hero Height",
      "options": [
        { "value": "100vh", "label": "Full Screen" },
        { "value": "80vh", "label": "Large" },
        { "value": "60vh", "label": "Medium" }
      ],
      "default": "100vh"
    }
  ],
  "presets": [
    {
      "name": "Hero Ritual Premium"
    }
  ]
}
{% endschema %}

<style>
.hero-ritual-premium {
  position: relative;
  height: {{ section.settings.height }};
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.1) 0%,
    rgba(0,0,0,0.3) 50%,
    rgba(0,0,0,0.5) 100%
  );
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  max-width: 800px;
  padding: 40px;
  text-align: {{ section.settings.text_position }};
  color: #fff;
}

.hero-eyebrow {
  font-size: 0.8rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  margin-bottom: 20px;
  opacity: 0.9;
  font-weight: 400;
}

.hero-heading {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 4rem;
  font-weight: 300;
  line-height: 1.1;
  margin-bottom: 30px;
  text-transform: none;
  letter-spacing: 0.02em;
}

.hero-subtext {
  font-size: 1.1rem;
  line-height: 1.7;
  max-width: 600px;
  margin: 0 auto 40px;
  opacity: 0.9;
  font-weight: 300;
}

.hero-btn {
  display: inline-block;
  padding: 18px 50px;
  background: transparent;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.8);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.8rem;
  transition: all 0.4s ease;
  font-weight: 400;
}

.hero-btn:hover {
  background: #fff;
  color: #1a1a1a;
}

/* Scroll Indicator */
.hero-scroll-indicator {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  opacity: 0.7;
  animation: bounce 2s infinite;
}

.hero-scroll-indicator span {
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.hero-scroll-indicator svg {
  width: 20px;
  height: 20px;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
  40% { transform: translateX(-50%) translateY(-10px); }
  60% { transform: translateX(-50%) translateY(-5px); }
}

@media (max-width: 768px) {
  .hero-ritual-premium {
    min-height: 500px;
  }
  
  .hero-heading {
    font-size: 2.5rem;
  }
  
  .hero-subtext {
    font-size: 1rem;
  }
  
  .hero-content {
    padding: 30px 20px;
  }
}
</style>

<section class="hero-ritual-premium">
  {% if section.settings.image %}
    <picture>
      {% if section.settings.mobile_image %}
        <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
      {% endif %}
      <img class="hero-bg-image" 
           src="{{ section.settings.image | image_url: width: 2000 }}" 
           alt="{{ section.settings.heading | escape }}"
           loading="eager">
    </picture>
  {% else %}
    <div class="hero-bg-image" style="background: linear-gradient(135deg, #5c4a3d 0%, #1a1a1a 100%);"></div>
  {% endif %}
  
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    {% if section.settings.eyebrow != blank %}
      <div class="hero-eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    
    <h1 class="hero-heading">{{ section.settings.heading }}</h1>
    
    {% if section.settings.subtext != blank %}
      <p class="hero-subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="hero-btn">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
  
  <div class="hero-scroll-indicator">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  if (typeof gsap !== 'undefined') {
    gsap.from(".hero-eyebrow", { opacity: 0, y: 20, duration: 1, delay: 0.3 });
    gsap.from(".hero-heading", { opacity: 0, y: 40, duration: 1.2, delay: 0.5 });
    gsap.from(".hero-subtext", { opacity: 0, y: 30, duration: 1, delay: 0.8 });
    gsap.from(".hero-btn", { opacity: 0, y: 20, duration: 1, delay: 1.1 });
    gsap.from(".hero-scroll-indicator", { opacity: 0, duration: 1, delay: 1.5 });
  }
});
</script>
