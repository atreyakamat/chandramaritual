{% schema %}
{
  "name": "Footer Ritual Complete",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Handcrafted for the modern mystic."
    }
  ],
  "presets": [
    {
      "name": "Footer Ritual Complete"
    }
  ]
}
{% endschema %}

<style>
.footer-ritual-complete {
  background-color: #000000;
  color: #ffffff;
  padding: 80px 40px 40px;
}

.footer-inner {
  max-width: 1400px;
  margin: 0 auto;
}

.footer-main-grid {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 60px;
  padding-bottom: 60px;
  border-bottom: 1px solid rgba(255,255,255,0.15);
  margin-bottom: 40px;
}

/* Logo Column */
.footer-logo-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.footer-logo-col img {
  max-width: 150px;
  filter: brightness(0) invert(1);
}

.footer-brand-name {
  font-size: 1.5rem;
  font-weight: 300;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

/* Links Column */
.footer-links-col {
  display: flex;
  justify-content: center;
  gap: 80px;
}

.footer-link-group h4 {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 25px;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
}

.footer-link-group ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-link-group li {
  margin-bottom: 15px;
}

.footer-link-group a {
  color: #fff;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 300;
  opacity: 0.8;
  transition: opacity 0.3s;
}

.footer-link-group a:hover {
  opacity: 1;
}

/* Newsletter Column */
.footer-newsletter-col {
  display: flex;
  flex-direction: column;
}

.footer-newsletter-col h4 {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 15px;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
}

.footer-newsletter-col p {
  font-size: 0.85rem;
  line-height: 1.6;
  margin-bottom: 25px;
  opacity: 0.8;
  font-weight: 300;
}

.footer-newsletter-form {
  display: flex;
  gap: 10px;
}

.footer-newsletter-form input {
  flex: 1;
  padding: 15px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.3);
  color: #fff;
  font-size: 0.85rem;
}

.footer-newsletter-form input::placeholder {
  color: rgba(255,255,255,0.5);
}

.footer-newsletter-form button {
  padding: 15px 25px;
  background: #fff;
  color: #000;
  border: none;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.75rem;
  cursor: pointer;
  transition: background 0.3s;
}

.footer-newsletter-form button:hover {
  background: #ddd;
}

/* Bottom Bar */
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  opacity: 0.6;
}

.footer-copyright {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.footer-payment-icons {
  display: flex;
  gap: 10px;
}

.footer-payment-icons svg {
  height: 24px;
  width: auto;
  fill: #fff;
  opacity: 0.7;
}

/* Mobile */
@media (max-width: 900px) {
  .footer-main-grid {
    grid-template-columns: 1fr;
    gap: 40px;
    text-align: center;
  }
  
  .footer-logo-col {
    align-items: center;
  }
  
  .footer-links-col {
    flex-direction: column;
    gap: 40px;
  }
  
  .footer-bottom {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
}
</style>

<footer class="footer-ritual-complete">
  <div class="footer-inner">
    
    <div class="footer-main-grid">
      
      <!-- Logo -->
      <div class="footer-logo-col">
        {% if section.settings.logo %}
          {{ section.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', alt: shop.name }}
        {% else %}
          <div class="footer-brand-name">{{ shop.name }}</div>
        {% endif %}
        <p style="font-size: 0.85rem; opacity: 0.7; margin-top: 10px;">{{ section.settings.tagline }}</p>
      </div>

      <!-- Links -->
      <div class="footer-links-col">
        <div class="footer-link-group">
          <h4>Shop</h4>
          <ul>
            <li><a href="/collections/all">All Collections</a></li>
            <li><a href="/collections/necklaces">Necklaces</a></li>
            <li><a href="/collections/waist-chains">Waist Chains</a></li>
            <li><a href="/collections/bracelets">Bracelets</a></li>
          </ul>
        </div>
        
        <div class="footer-link-group">
          <h4>Information</h4>
          <ul>
            {% for link in linklists[section.settings.menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
            {% if linklists[section.settings.menu].links.size == 0 %}
              <li><a href="/pages/about">About Us</a></li>
              <li><a href="/pages/contact">Contact</a></li>
              <li><a href="/policies/shipping-policy">Shipping</a></li>
              <li><a href="/policies/refund-policy">Returns</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="footer-newsletter-col">
        <h4>Receive Lunar Notes</h4>
        <p>Stay connected to the phases. Receive rituals, new moon intentions, and exclusive offerings.</p>
        
        <form method="post" action="/contact#newsletter" class="footer-newsletter-form" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Your email" required>
          <button type="submit">Join</button>
        </form>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <span>© {{ 'now' | date: "%Y" }}, {{ shop.name }}.</span>
        <span>{{ section.settings.tagline }}</span>
      </div>
      
      <div class="footer-payment-icons">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    </div>

  </div>
</footer>
