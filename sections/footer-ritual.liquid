{% schema %}
{
  "name": "Footer Ritual",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Stay up to date with the new collections, products and exclusive offers."
    }
  ],
  "presets": [
    {
      "name": "Footer Ritual"
    }
  ]
}
{% endschema %}

{% style %}
.footer-ritual {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: 80px 40px 40px;
  font-family: inherit;
}

.footer-ritual-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 40px;
  max-width: 1400px;
  margin: 0 auto;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  padding-bottom: 60px;
  margin-bottom: 40px;
}

/* Col 1: Logo */
.footer-logo {
  display: flex;
  align-items: flex-start;
}

.footer-logo img {
  object-fit: contain;
}

/* Col 2: Links */
.footer-links {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.footer-links a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 300;
  letter-spacing: 0.05em;
  opacity: 0.8;
  transition: opacity 0.3s;
  width: fit-content;
}

.footer-links a:hover {
  opacity: 1;
}

/* Col 3: Newsletter */
.footer-newsletter {
  display: flex;
  flex-direction: column;
}

.newsletter-title {
  font-size: 1.2rem;
  font-weight: 400;
  margin-bottom: 20px;
  letter-spacing: 0.05em;
}

.newsletter-text {
  font-size: 0.9rem;
  opacity: 0.8;
  margin-bottom: 30px;
  line-height: 1.5;
  font-weight: 300;
}

.footer-form {
  position: relative;
  max-width: 100%;
}

.footer-form input[type="email"] {
  width: 100%;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.3);
  padding: 15px;
  color: #fff;
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-form input[type="email"]::placeholder {
  color: rgba(255,255,255,0.5);
}

.footer-form button {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 5px;
}

/* Bottom Bar */
.footer-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  font-size: 0.8rem;
  opacity: 0.7;
  text-align: center;
}

.payment-icons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
}

.payment-icons svg {
  height: 24px;
  width: auto;
}

@media (max-width: 900px) {
  .footer-ritual-grid {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 60px;
  }
  
  .footer-logo {
    justify-content: center;
    margin-bottom: 20px;
  }
  
  .footer-links {
    align-items: center;
  }
}
{% endstyle %}

<footer class="footer-ritual">
  <div class="footer-ritual-grid">
    
    <!-- Logo -->
    <div class="footer-logo">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: loading: 'lazy', alt: shop.name }}
      {% else %}
        <h2 style="font-size: 2rem; margin: 0;">{{ shop.name }}</h2>
      {% endif %}
    </div>

    <!-- Links -->
    <div class="footer-links">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>

    <!-- Newsletter -->
    <div class="footer-newsletter">
      <div class="newsletter-title">{{ section.settings.newsletter_heading }}</div>
      <div class="newsletter-text">{{ section.settings.newsletter_text }}</div>
      
      {% form 'customer', class: 'footer-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="YOUR EMAIL" required>
        <button type="submit" aria-label="Subscribe">
           <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
             <polyline points="9 18 15 12 9 6"></polyline>
           </svg>
        </button>
      {% endform %}
    </div>
  </div>

  <div class="footer-bottom">
    <div>&copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}. Powered by Shopify.</div>
    
    <div class="payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag }}
      {%- endfor -%}
    </div>
  </div>
</footer>
