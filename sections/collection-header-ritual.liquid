{% schema %}
{
  "name": "Collection Header Ritual",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    }
  ]
}
{% endschema %}

{% style %}
.collection-ritual-header {
  background-color: #f0ede6;
  padding: 100px 40px;
  text-align: center;
}

.collection-ritual-title {
  font-size: 2.5rem;
  font-weight: 300;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 20px;
  color: #1a1a1a;
  opacity: 0;
  transform: translateY(30px);
}

.collection-ritual-subtitle {
  font-size: 1.3rem;
  font-weight: 300;
  letter-spacing: 0.1em;
  color: #8a7355;
  margin-bottom: 30px;
  opacity: 0;
  transform: translateY(20px);
}

.collection-ritual-description {
  max-width: 900px;
  margin: 0 auto;
  font-size: 1.05rem;
  line-height: 1.7;
  color: #555;
  font-weight: 300;
  opacity: 0;
  transform: translateY(20px);
}

.collection-ritual-divider {
  width: 60px;
  height: 1px;
  background: #8a7355;
  margin: 40px auto;
  opacity: 0;
}

@media (max-width: 768px) {
  .collection-ritual-header {
    padding: 60px 20px;
  }
  
  .collection-ritual-title {
    font-size: 1.8rem;
  }
}
{% endstyle %}

<section class="collection-ritual-header">
  <h1 class="collection-ritual-title">{{ collection.title }}</h1>
  
  {% if collection.metafields.custom.subtitle %}
    <p class="collection-ritual-subtitle">{{ collection.metafields.custom.subtitle }}</p>
  {% endif %}
  
  <div class="collection-ritual-divider"></div>
  
  {% if section.settings.show_description and collection.description != blank %}
    <div class="collection-ritual-description">
      {{ collection.description }}
    </div>
  {% endif %}
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== 'undefined') {
      gsap.to(".collection-ritual-title", {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power2.out"
      });
      
      gsap.to(".collection-ritual-subtitle", {
        opacity: 1,
        y: 0,
        duration: 1,
        delay: 0.2,
        ease: "power2.out"
      });
      
      gsap.to(".collection-ritual-divider", {
        opacity: 1,
        duration: 1,
        delay: 0.3,
        ease: "power2.out"
      });
      
      gsap.to(".collection-ritual-description", {
        opacity: 1,
        y: 0,
        duration: 1,
        delay: 0.4,
        ease: "power2.out"
      });
    }
  });
</script>
