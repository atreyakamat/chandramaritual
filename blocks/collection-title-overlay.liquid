{%- comment -%}
  Collection Title Overlay Animation
  
  Displays an animated collection title that overlays on collection images.
  Features a two-tone typography treatment with a sliding gold background on hover.
  
  CSS Styles: Located in assets/base.css (search for "Collection Title Overlay Animation")
  
  @param block.settings.show_prefix - Show prefix word before collection name
  @param block.settings.use_custom_split - Use custom text instead of automatic splitting
  @param block.settings.brand_gold - Brand gold color (default: #91705E)
{%- endcomment -%}

{% liquid
  if closest.collection == blank
    assign collection_title = 'placeholders.collection_title' | t
  else
    assign collection_title = closest.collection.title
  endif

  # Determine how to split the title
  if block.settings.use_custom_split
    # Use custom text provided by merchant
    assign prefix_text = block.settings.custom_prefix
    assign main_text = block.settings.custom_main | default: collection_title
  elsif block.settings.show_prefix
    # Auto-split: use first word as prefix
    assign title_words = collection_title | split: ' '
    assign prefix_text = block.settings.prefix_text | default: title_words.first
    
    if title_words.size > 1
      assign remaining_words = title_words | shift
      assign main_text = remaining_words | join: ' '
    else
      # If only one word, show it all as main
      assign prefix_text = ''
      assign main_text = collection_title
    endif
  else
    # No prefix, show entire title as main
    assign prefix_text = ''
    assign main_text = collection_title
  endif
%}

<div
  class="collection-title-overlay-wrapper"
  style="
    --overlay-bottom: {{ block.settings.bottom_position }}px;
    --overlay-left: {{ block.settings.left_position }}px;
    --overlay-padding-block: {{ block.settings.padding_block }}px;
    --overlay-padding-inline: {{ block.settings.padding_inline }}px;
    --animation-duration: {{ block.settings.animation_duration }}s;
    --brand-gold: {{ block.settings.brand_gold }};
  "
>
  <span class="collection-title-overlay">
    {% if prefix_text != blank %}
      <span class="title-prefix">{{ prefix_text }}</span>
    {% endif %}
    <span class="title-main">{{ main_text }}</span>
  </span>
</div>

{% schema %}
{
  "name": "Collection Title Overlay",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Animated collection title that overlays on the collection image with a slide-in gold background on hover."
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "checkbox",
      "id": "show_prefix",
      "label": "Show prefix word",
      "default": true,
      "info": "Display 'THE' before the collection name in black"
    },
    {
      "type": "text",
      "id": "prefix_text",
      "label": "Prefix text",
      "default": "THE",
      "visible_if": "{{ block.settings.show_prefix }}"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "bottom_position",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "left_position",
      "label": "Left spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration",
      "min": 0.3,
      "max": 2.0,
      "step": 0.1,
      "unit": "s",
      "default": 0.7,
      "info": "Duration of the slide animation (0.6-0.8s recommended)"
    },
    {
      "type": "header",
      "content": "Advanced: Custom Split"
    },
    {
      "type": "checkbox",
      "id": "use_custom_split",
      "label": "Use custom title split",
      "default": false,
      "info": "Override automatic splitting for collections that don't fit the 'THE + NAME' pattern"
    },
    {
      "type": "text",
      "id": "custom_prefix",
      "label": "Custom prefix (black)",
      "placeholder": "e.g., NEW",
      "visible_if": "{{ block.settings.use_custom_split }}",
      "info": "Leave empty to show only the main text"
    },
    {
      "type": "text",
      "id": "custom_main",
      "label": "Custom main text (gold)",
      "placeholder": "Collection name",
      "visible_if": "{{ block.settings.use_custom_split }}",
      "info": "Leave empty to use the collection title"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "brand_gold",
      "label": "Brand gold color",
      "default": "#91705E",
      "info": "Used for the main title text and hover background"
    }
  ],
  "presets": [
    {
      "name": "Collection Title Overlay",
      "category": "Collection"
    }
  ]
}
{% endschema %}
